{
    "name": "joby/html-object-strings",
    "description": "A comprehensive PHP library for programmatically building HTML. Covers essentially all of HTML5, plus SVG and MathML.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Joby\\HTML\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joby\\HTML\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Joby Elliott",
            "email": "code@byjoby.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "myclabs/deep-copy": "^1"
    },
    "require-dev": {
        "php": "^8.3",
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "^1",
        "mustangostang/spyc": "^0.6.3"
    }
}
